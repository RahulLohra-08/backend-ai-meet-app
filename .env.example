# ---------- Core ----------
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (CORS + Socket.IO)
FRONTEND_URL=http://localhost:5173
# Local MongoDB, or your Atlas connection string (mongodb+srv://USER:PASSWORD@cluster.xxxx.mongodb.net/lingua_meet)
MONGODB_URI=mongodb://127.0.0.1:27017/lingua_meet
# Only if your network cannot resolve Atlas SRV records (e.g. "8.8.8.8,8.8.4.4"). Leave empty otherwise.
DNS_SERVERS=

# ---------- Auth ----------
# REQUIRED: long random string (>= 32 chars in production). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Refresh-token cookie. 'auto' = Secure only in production. Use COOKIE_SAMESITE=none (+ HTTPS) if frontend and API are on different sites.
COOKIE_SECURE=auto
COOKIE_SAMESITE=lax
TRUST_PROXY=false

# ---------- Speech-to-text (server-side engine) ----------
# Any OpenAI-compatible /audio/transcriptions endpoint: OpenAI (whisper-1), Groq (whisper-large-v3*), self-hosted faster-whisper...
# Leave the key empty to use only the free in-browser speech engine.
STT_PROVIDER=openai
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1

# ---------- Translation ----------
# auto = LibreTranslate if LIBRETRANSLATE_URL is set, else the LLM below if OPENAI_API_KEY is set
TRANSLATION_PROVIDER=auto
# Self-host: docker run -p 5000:5000 libretranslate/libretranslate  ->  http://localhost:5000
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# ---------- LLM (meeting notes; also translation fallback) ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---------- LLM traffic control (notes + translation share these limits) ----------
# Accounts WITHOUT billing on OpenAI only allow a few requests per minute: set LLM_MAX_RPM=3 there.
LLM_MAX_RPM=20
LLM_MAX_CONCURRENCY=2
LLM_MAX_RETRIES=3
# Optional second provider, used ONLY when the first one is rate limited / out of quota / down. All three must be set.
# Any OpenAI-compatible API works (Groq, OpenRouter, Together, a local server...). Results record which provider answered.
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
# Translation batching: captions arriving within this window (ms) are translated in ONE request
TRANSLATION_BATCH_WINDOW_MS=700
TRANSLATION_BATCH_MAX=6
TRANSLATION_AUTO_RETRIES=3
# Same speaker + same text within this window (ms) is treated as a duplicate caption (0 = off)
DUPLICATE_WINDOW_MS=4000

# ---------- Behaviour ----------
# Generate AI notes automatically when the host ends a meeting
SUMMARY_AUTO_ON_END=true
# Auto-delete completed meetings after N days (0 = keep forever)
RETENTION_DAYS=0

# ---------- Development helpers (REFUSED when NODE_ENV=production) ----------
# Labelled fake translation (tiny Hindi/English phrasebook) + placeholder notes so you can click through the UI with no API keys.
DEV_MOCK_PROVIDERS=false
# Return the password-reset link in the API response (there is no mail server wired in)
DEV_EXPOSE_RESET_LINK=false
