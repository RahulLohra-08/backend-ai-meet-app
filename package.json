{
  "name": "lingua-meet-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Express + MongoDB + Socket.IO backend for the Lingua Meet multilingual meeting assistant",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1 --test-timeout=60000",
    "check": "node --check src/server.js",
    "indexes:check": "node scripts/check-indexes.js",
    "indexes:fix": "node scripts/check-indexes.js --apply",
    "test:unit": "node --test tests/unit.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.2",
    "socket.io-client": "^4.8.1"
  }
}